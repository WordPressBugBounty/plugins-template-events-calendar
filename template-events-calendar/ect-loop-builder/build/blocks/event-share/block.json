{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "elb/event-share",
  "textdomain": "template-events-calendar",
  "title": "Event Share",
  "icon": "share",
  "category": "widgets",
  "keywords": [
    "share",
    "social",
    "facebook"
  ],
  "editorScript": "elb-editor",
  "usesContext": [
    "elb/postId"
  ],
  "attributes": {
    "shareNetworks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "facebook",
        "twitter",
        "copy"
      ]
    },
    "sourceField": {
      "type": "string",
      "default": "share"
    },
    "sharePreset": {
      "type": "string",
      "default": "classic"
    },
    "shareSize": {
      "type": "number",
      "default": 44
    },
    "showLabels": {
      "type": "boolean",
      "default": false
    },
    "borderRadius": {
      "type": "number",
      "default": 8
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "hoverTextColor": {
      "type": "string",
      "default": ""
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "hoverBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "paddingTop": {
      "type": "string",
      "default": ""
    },
    "paddingRight": {
      "type": "string",
      "default": ""
    },
    "paddingBottom": {
      "type": "string",
      "default": ""
    },
    "paddingLeft": {
      "type": "string",
      "default": ""
    },
    "paddingUnit": {
      "type": "string",
      "default": "PX"
    },
    "marginTop": {
      "type": "string",
      "default": "0"
    },
    "marginRight": {
      "type": "string",
      "default": "0"
    },
    "marginBottom": {
      "type": "string",
      "default": "0"
    },
    "marginLeft": {
      "type": "string",
      "default": "0"
    },
    "marginUnit": {
      "type": "string",
      "default": "PX"
    },
    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderRadiusTopLeft": {
      "type": "string",
      "default": ""
    },
    "borderRadiusTopRight": {
      "type": "string",
      "default": ""
    },
    "borderRadiusBottomRight": {
      "type": "string",
      "default": ""
    },
    "borderRadiusBottomLeft": {
      "type": "string",
      "default": ""
    },
    "borderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "borderWidth": {
      "type": "string",
      "default": ""
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "fontFamily": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "string",
      "default": ""
    },
    "fontSizeUnit": {
      "type": "string",
      "default": "px"
    },
    "fontWeight": {
      "type": "string",
      "default": ""
    },
    "lineHeight": {
      "type": "string",
      "default": ""
    },
    "lineHeightUnit": {
      "type": "string",
      "default": "em"
    },
    "letterSpacing": {
      "type": "string",
      "default": ""
    },
    "letterSpacingUnit": {
      "type": "string",
      "default": "px"
    },
    "textTransform": {
      "type": "string",
      "default": ""
    },
    "fontStyle": {
      "type": "string",
      "default": ""
    },
    "textDecoration": {
      "type": "string",
      "default": ""
    },
    "flexDirection": {
      "type": "string",
      "default": ""
    },
    "justifyContent": {
      "type": "string",
      "default": ""
    },
    "alignItems": {
      "type": "string",
      "default": ""
    },
    "flexWrap": {
      "type": "string",
      "default": ""
    },
    "flexGap": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true
  },
  "render": "file:./render.php",
  "description": "Show social share buttons for the event.",
  "ancestor": [
    "elb/loop-builder"
  ]
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "elb/event-image",
  "textdomain": "template-events-calendar",
  "title": "Event Image",
  "icon": "format-image",
  "category": "widgets",
  "description": "Show the event's featured image.",
  "keywords": [
    "event",
    "image",
    "thumbnail",
    "elb"
  ],
  "editorScript": "elb-editor",
  "usesContext": [
    "elb/postId"
  ],
  "attributes": {
    "sourceField": {
      "type": "string",
      "default": "image"
    },
    "enableLink": {
      "type": "boolean",
      "default": true
    },
    "linkNewTab": {
      "type": "boolean",
      "default": false
    },
    "linkSource": {
      "type": "string",
      "default": "permalink"
    },
    "aspectRatio": {
      "type": "string",
      "default": "4/3"
    },
    "imageStyle": {
      "type": "string",
      "default": "default"
    },
    "autoHeight": {
      "type": "boolean",
      "default": true
    },
    "hoverEffect": {
      "type": "string",
      "default": ""
    },
    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderColorHover": {
      "type": "string",
      "default": ""
    },
    "borderWidth": {
      "type": "string",
      "default": ""
    },
    "borderRadiusTopLeft": {
      "type": "string",
      "default": ""
    },
    "borderRadiusTopRight": {
      "type": "string",
      "default": ""
    },
    "borderRadiusBottomRight": {
      "type": "string",
      "default": ""
    },
    "borderRadiusBottomLeft": {
      "type": "string",
      "default": ""
    },
    "borderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "imageSize": {
      "type": "string",
      "default": "large"
    },
    "hoverDuration": {
      "type": "number",
      "default": 0
    },
    "marginTop": {
      "type": "string",
      "default": ""
    },
    "marginRight": {
      "type": "string",
      "default": ""
    },
    "marginBottom": {
      "type": "string",
      "default": ""
    },
    "marginLeft": {
      "type": "string",
      "default": ""
    },
    "marginUnit": {
      "type": "string",
      "default": "PX"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true
  },
  "render": "file:./render.php",
  "ancestor": [
    "elb/loop-builder"
  ]
}

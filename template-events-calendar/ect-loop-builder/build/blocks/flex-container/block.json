{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "elb/flex-container",
  "title": "Container",
  "category": "elb-blocks",
  "description": "Group blocks and arrange them in rows or columns.",
  "keywords": [
    "container",
    "group",
    "row",
    "column",
    "flex",
    "layout",
    "wrapper"
  ],
  "textdomain": "template-events-calendar",
  "supports": {
    "anchor": true,
    "html": false,
    "inserter": false
  },
  "usesContext": [
    "elb/postId",
    "elb/postType"
  ],
  "editorScript": "elb-layout-blocks-editor",
  "attributes": {
    "block_id": {
      "type": "string"
    },
    "elbRole": {
      "type": "string",
      "default": ""
    },
    "elbFrontendCss": {
      "type": "string",
      "default": ""
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlTagLink": {
      "type": "object"
    },
    "linkTarget": {
      "type": "boolean",
      "default": false
    },
    "contentWidth": {
      "type": "string",
      "default": "alignfull"
    },
    "innerContentWidth": {
      "type": "string",
      "default": "alignwide"
    },
    "widthDesktop": {
      "type": "number",
      "default": 100
    },
    "widthType": {
      "type": "string",
      "default": "%"
    },
    "innerContentCustomWidthDesktop": {
      "type": "number",
      "default": 1200
    },
    "innerContentCustomWidthType": {
      "type": "string",
      "default": "px"
    },
    "minHeightDesktop": {
      "type": "number"
    },
    "minHeightType": {
      "type": "string",
      "default": "px"
    },
    "directionDesktop": {
      "type": "string",
      "default": "column"
    },
    "alignItemsDesktop": {
      "type": "string",
      "default": "center"
    },
    "justifyContentDesktop": {
      "type": "string",
      "default": "center"
    },
    "wrapDesktop": {
      "type": "string",
      "default": "nowrap"
    },
    "alignContentDesktop": {
      "type": "string",
      "default": ""
    },
    "backgroundType": {
      "type": "string",
      "default": "none"
    },
    "backgroundColor": {
      "type": "string"
    },
    "boxShadowColor": {
      "type": "string",
      "default": "#00000070"
    },
    "boxShadowHOffset": {
      "type": "number",
      "default": 0
    },
    "boxShadowVOffset": {
      "type": "number",
      "default": 0
    },
    "boxShadowBlur": {
      "type": "number"
    },
    "boxShadowSpread": {
      "type": "number"
    },
    "boxShadowPosition": {
      "type": "string",
      "default": "outset"
    },
    "boxShadowColorHover": {
      "type": "string"
    },
    "boxShadowHOffsetHover": {
      "type": "number",
      "default": 0
    },
    "boxShadowVOffsetHover": {
      "type": "number",
      "default": 0
    },
    "boxShadowBlurHover": {
      "type": "number"
    },
    "boxShadowSpreadHover": {
      "type": "number"
    },
    "boxShadowPositionHover": {
      "type": "string",
      "default": "outset"
    },
    "topPaddingDesktop": {
      "type": "number",
      "default": 10
    },
    "bottomPaddingDesktop": {
      "type": "number",
      "default": 10
    },
    "leftPaddingDesktop": {
      "type": "number",
      "default": 10
    },
    "rightPaddingDesktop": {
      "type": "number",
      "default": 10
    },
    "paddingType": {
      "type": "string",
      "default": "px"
    },
    "paddingLink": {
      "type": "boolean",
      "default": true
    },
    "topMarginDesktop": {
      "type": "number"
    },
    "bottomMarginDesktop": {
      "type": "number"
    },
    "leftMarginDesktop": {
      "type": "number"
    },
    "rightMarginDesktop": {
      "type": "number"
    },
    "marginType": {
      "type": "string",
      "default": "px"
    },
    "marginLink": {
      "type": "boolean",
      "default": true
    },
    "variationSelected": {
      "type": "boolean",
      "default": false
    },
    "rowGapDesktop": {
      "type": "number",
      "default": 20
    },
    "rowGapType": {
      "type": "string",
      "default": "px"
    },
    "columnGapDesktop": {
      "type": "number",
      "default": 20
    },
    "columnGapType": {
      "type": "string",
      "default": "px"
    },
    "isBlockRootParent": {
      "type": "boolean",
      "default": false
    },
    "widthSetByUser": {
      "type": "boolean",
      "default": false
    },
    "textColor": {
      "type": "string"
    },
    "linkColor": {
      "type": "string"
    },
    "linkHoverColor": {
      "type": "string"
    },
    "overflow": {
      "type": "string",
      "default": "visible"
    },
    "equalHeight": {
      "type": "boolean",
      "default": false
    },
    "containerBorderTopWidth": {
      "type": "number",
      "default": ""
    },
    "containerBorderLeftWidth": {
      "type": "number",
      "default": ""
    },
    "containerBorderRightWidth": {
      "type": "number",
      "default": ""
    },
    "containerBorderBottomWidth": {
      "type": "number",
      "default": ""
    },
    "containerBorderTopLeftRadius": {
      "type": "number",
      "default": ""
    },
    "containerBorderTopRightRadius": {
      "type": "number",
      "default": ""
    },
    "containerBorderBottomLeftRadius": {
      "type": "number",
      "default": ""
    },
    "containerBorderBottomRightRadius": {
      "type": "number",
      "default": ""
    },
    "containerBorderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "containerBorderLink": {
      "type": "boolean",
      "default": true
    },
    "containerBorderRadiusLink": {
      "type": "boolean",
      "default": true
    },
    "containerBorderStyle": {
      "type": "string",
      "default": ""
    },
    "containerBorderColor": {
      "type": "string",
      "default": ""
    },
    "containerBorderHColor": {
      "type": "string",
      "default": ""
    },
    "childrenWidthDesktop": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "default": ""
    }
  }
}
